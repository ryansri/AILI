# Nothing here is needed to run AILI on your own computer. Copy to .env and fill
# in what you use.

# Local database file (relative to prisma/). Used when TURSO_DATABASE_URL is not set.
DATABASE_URL="file:./dev.db"

# --- Hosting (set these in Vercel, Project Settings, Environment Variables) ---

# Turso database: `turso db show <name> --url` and `turso db tokens create <name>`.
# Keep these out of your local .env unless you want local AILI to use Turso too.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Signs login sessions. Any long random string: `openssl rand -base64 32`.
AUTH_SECRET=""

# The address AILI is served at, used in password reset links.
APP_URL=""

# Password reset by email through Resend (resend.com). Without it, reset links
# are printed by `npm run reset:password -- you@example.com`.
RESEND_API_KEY=""
RESEND_FROM="AILI <onboarding@resend.dev>"

# The extension's Chrome Web Store page, once published. Onboarding's Install button opens it.
NEXT_PUBLIC_EXTENSION_URL=""

# --- The Chrome extension ---

# The hosted AILI the extension is built for (`npm run helper:build`). One exact
# https address; the extension only talks to this page and localhost.
AILI_URL=""
