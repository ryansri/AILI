{
  "manifest_version": 3,
  "name": "AILI helper",
  "version": "0.1.0",
  "description": "Syncs your LinkedIn inbox with AILI and delivers the messages you click Send on. Not affiliated with LinkedIn.",
  "permissions": ["cookies", "storage", "alarms", "declarativeNetRequest"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "AILI helper" }
}
