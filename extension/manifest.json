{
  "manifest_version": 3,
  "name": "AILI helper",
  "version": "0.5.2",
  "description": "Syncs your LinkedIn inbox with AILI and delivers the messages you click Send on. Not affiliated with LinkedIn.",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "declarativeNetRequest",
    "notifications"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AILI helper",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
