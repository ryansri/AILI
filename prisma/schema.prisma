// AILI data model. SQLite for local development; the same schema moves to
// Postgres by changing the datasource provider and running a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One LinkedIn profile being worked from AILI. Multi-user later; one row for now.
model Workspace {
  id           String    @id @default(cuid())
  name         String
  initials     String
  dailyCap     Int       @default(20)
  /// Login. Null until the owner registers on first run.
  email        String?   @unique
  passwordHash String?
  /// A one-time password reset from `npm run reset:password`: sha256 of the token, and when it stops working.
  resetTokenHash    String?
  resetTokenExpires DateTime?
  /// When onboarding finished (or was skipped). Until then, an account with nothing synced goes to /welcome.
  onboardedAt       DateTime?
  /// Bearer token the Chrome helper uses. Shown once in Settings, can be rotated.
  helperToken  String?   @unique
  /// What the helper last reported about itself.
  helperLastSeenAt DateTime?
  helperMemberUrn  String?
  /// What the helper last said about its work, for the status line and import card.
  helperImported   Int       @default(0)
  helperImporting  Boolean   @default(false)
  helperPhase      String?
  helperPausedUntil DateTime?
  helperError      String?
  /// When the people from before leads existed were sorted into leads and Other, once.
  leadsSortedAt    DateTime?
  helperName       String?
  /// Your LinkedIn profile photo, reported by the helper.
  helperPictureUrl String?
  /// Version of the Chrome helper that last reported in.
  helperVersion    String?
  /// Show a desktop notification (through the helper) when someone replies.
  notifyReplies    Boolean   @default(true)
  helperState      String?
  /// The browser's time zone (e.g. Australia/Sydney), for scheduling posts from Claude or ChatGPT.
  timeZone         String?
  /// LinkedIn's official connection for publishing posts (separate from the helper).
  /// The access token is encrypted with the server secret.
  linkedinPostToken   String?
  linkedinPostRefresh String?
  linkedinPostExpires DateTime?
  /// urn:li:person:<id>, the author of published posts.
  linkedinPostUrn     String?
  linkedinPostName    String?
  /// Minutes between a post going live and its first comment (0 is right away).
  firstCommentDelay   Int       @default(5)
  createdAt    DateTime  @default(now())

  people Person[]
  tags   Tag[]
  stages Stage[]
  templates Template[]
  outbox Outbox[]
  posts  Post[]
  aiGrants AiGrant[]
}

model Person {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  headline    String    @default("")
  company     String    @default("")
  location    String    @default("")
  linkedinUrl String    @default("")
  /// LinkedIn identity from the helper, e.g. urn:li:fsd_profile:ABC. Unique per workspace.
  linkedinUrn String?
  /// LinkedIn public id, the /in/<id> part of the profile URL.
  publicId    String?
  pictureUrl  String    @default("")
  /// LinkedIn conversation id the helper syncs messages from.
  conversationId String?
  /// Where the row came from: "manual" or "linkedin".
  source      String    @default("manual")
  /// Stage key, see the Stage model
  stage       String    @default("warming")
  /// A lead counts in People, the funnel, the inbox views and every count.
  /// Anyone else synced from LinkedIn sits in Other: readable and repliable, but not tracked.
  lead        Boolean   @default(true)
  /// When the person last moved stage. Drives "days in stage" on the People page.
  /// Empty for people from before it was recorded; the page estimates from other dates.
  stageChangedAt DateTime?
  notes       String    @default("")
  starred     Boolean   @default(false)
  connectedAt DateTime?
  requestedAt DateTime?
  snoozedUntil DateTime?
  archivedAt  DateTime?
  /// Last time the user did something to this person in AILI (stage, note, tag, send, snooze).
  lastActionAt DateTime?
  /// The user pressed Done: nothing more to do until a new message arrives either way.
  handledAt   DateTime?
  /// Current job title, from the person's LinkedIn profile or typed by the user.
  jobTitle    String    @default("")
  /// When the helper last looked up the LinkedIn profile for title and company.
  profileCheckedAt DateTime?
  /// When the user last saved this person by hand. Profile lookups never overwrite after that.
  profileEditedAt  DateTime?
  /// A message written for this person in Claude or ChatGPT, waiting in the message box. Never sent by itself.
  draft       String?
  /// Who wrote the draft, e.g. "Claude" or "ChatGPT".
  draftSource String?
  draftAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags     PersonTag[]
  messages Message[]
  outbox   Outbox[]

  @@unique([workspaceId, linkedinUrn])
  @@index([workspaceId, stage])
}

/// A pipeline stage. The eight built-in ones keep fixed keys the app's rules use
/// (warming, requested, connected, conversation, call, pilot, won, lost); stages the
/// user adds get a generated key. Position sets the order everywhere.
model Stage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  label       String
  position    Int
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, key])
}

/// A saved message. {first_name}, {name}, {company} and {title} fill in per person.
model Template {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  label       String
  /// amber | green | violet | blue | pink | stone
  color       String    @default("stone")
  createdAt   DateTime  @default(now())

  people PersonTag[]

  @@unique([workspaceId, label])
}

model PersonTag {
  personId String
  tagId    String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([personId, tagId])
}

model Message {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// "in" from the prospect, "out" from the user
  direction String
  body      String
  sentAt    DateTime
  /// 1 or 2 when this outbound message was a planned follow-up
  followUp  Int?
  /// "manual" (logged by hand), "helper" (Chrome helper), "api"
  source    String   @default("manual")
  /// Id on LinkedIn's side when synced, to avoid duplicates
  externalId String? @unique
  createdAt DateTime @default(now())

  @@index([personId, sentAt])
}

/// A message the user clicked Send on, waiting for the Chrome helper to deliver it.
model Outbox {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  body        String
  followUp    Int?
  /// queued | sending | sent | failed
  status      String    @default("queued")
  error       String?
  externalId  String?
  createdAt   DateTime  @default(now())
  claimedAt   DateTime?
  sentAt      DateTime?

  @@index([workspaceId, status])
}

/// A LinkedIn post or article. Posts publish through LinkedIn's official API,
/// now or at scheduledAt; articles are opened in LinkedIn's editor for the user to publish.
model Post {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// post | article
  kind        String    @default("post")
  /// Articles only.
  title       String    @default("")
  body        String
  /// draft | scheduled | publishing | published | failed
  status      String    @default("draft")
  scheduledAt DateTime?
  publishedAt DateTime?
  /// The LinkedIn post's urn once published, e.g. urn:li:share:123.
  linkedinUrn String?
  error       String?
  /// Where it was written: "AILI", "Claude", "ChatGPT" or another app's name.
  source      String    @default("AILI")
  /// Posted as a comment under the post once it is live, e.g. the link. Empty for none.
  firstComment      String    @default("")
  /// pending | posting | posted | failed; null when there is no first comment yet.
  commentStatus     String?
  /// When the first comment is due: the publish time plus the workspace's delay.
  commentAt         DateTime?
  commentUrn        String?
  commentError      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([commentStatus, commentAt])
  @@index([workspaceId, status])
}

/// An app such as Claude or ChatGPT that registered itself to connect to AILI (OAuth dynamic client registration).
model AiClient {
  id           String   @id
  name         String
  /// JSON array of allowed redirect addresses.
  redirectUris String
  createdAt    DateTime @default(now())
}

/// A one-time code from the Allow screen, swapped for tokens within 10 minutes.
model AiCode {
  id            String   @id @default(cuid())
  codeHash      String   @unique
  clientId      String
  workspaceId   String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
}

/// One connection of Claude or ChatGPT to a workspace. Tokens are stored as sha256 hashes.
model AiGrant {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId       String
  clientName     String
  accessHash     String    @unique
  accessExpires  DateTime
  refreshHash    String    @unique
  refreshExpires DateTime
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([workspaceId])
}

/// Small shared values, e.g. when the scheduled-posts timer last ran.
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
