// AILI data model. SQLite for local development; the same schema moves to
// Postgres by changing the datasource provider and running a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One LinkedIn profile being worked from AILI. Multi-user later; one row for now.
model Workspace {
  id           String    @id @default(cuid())
  name         String
  initials     String
  dailyCap     Int       @default(20)
  /// Login. Null until the owner registers on first run.
  email        String?   @unique
  passwordHash String?
  /// Bearer token the Chrome helper uses. Shown once in Settings, can be rotated.
  helperToken  String?   @unique
  /// What the helper last reported about itself.
  helperLastSeenAt DateTime?
  helperMemberUrn  String?
  /// When the people from before leads existed were sorted into leads and Other, once.
  leadsSortedAt    DateTime?
  helperName       String?
  /// Your LinkedIn profile photo, reported by the helper.
  helperPictureUrl String?
  /// Version of the Chrome helper that last reported in.
  helperVersion    String?
  /// Show a desktop notification (through the helper) when someone replies.
  notifyReplies    Boolean   @default(true)
  helperState      String?
  createdAt    DateTime  @default(now())

  people Person[]
  tags   Tag[]
  stages Stage[]
  templates Template[]
  outbox Outbox[]
}

model Person {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  headline    String    @default("")
  company     String    @default("")
  location    String    @default("")
  linkedinUrl String    @default("")
  /// LinkedIn identity from the helper, e.g. urn:li:fsd_profile:ABC. Unique per workspace.
  linkedinUrn String?
  /// LinkedIn public id, the /in/<id> part of the profile URL.
  publicId    String?
  pictureUrl  String    @default("")
  /// LinkedIn conversation id the helper syncs messages from.
  conversationId String?
  /// Where the row came from: "manual" or "linkedin".
  source      String    @default("manual")
  /// Stage key, see the Stage model
  stage       String    @default("warming")
  /// A lead counts in People, the funnel, the inbox views and every count.
  /// Anyone else synced from LinkedIn sits in Other: readable and repliable, but not tracked.
  lead        Boolean   @default(true)
  /// When the person last moved stage. Drives "days in stage" on the People page.
  /// Empty for people from before it was recorded; the page estimates from other dates.
  stageChangedAt DateTime?
  notes       String    @default("")
  starred     Boolean   @default(false)
  connectedAt DateTime?
  requestedAt DateTime?
  snoozedUntil DateTime?
  archivedAt  DateTime?
  /// Last time the user did something to this person in AILI (stage, note, tag, send, snooze).
  lastActionAt DateTime?
  /// The user pressed Done: nothing more to do until a new message arrives either way.
  handledAt   DateTime?
  /// Current job title, from the person's LinkedIn profile or typed by the user.
  jobTitle    String    @default("")
  /// When the helper last looked up the LinkedIn profile for title and company.
  profileCheckedAt DateTime?
  /// When the user last saved this person by hand. Profile lookups never overwrite after that.
  profileEditedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags     PersonTag[]
  messages Message[]
  outbox   Outbox[]

  @@unique([workspaceId, linkedinUrn])
  @@index([workspaceId, stage])
}

/// A pipeline stage. The eight built-in ones keep fixed keys the app's rules use
/// (warming, requested, connected, conversation, call, pilot, won, lost); stages the
/// user adds get a generated key. Position sets the order everywhere.
model Stage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  label       String
  position    Int
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, key])
}

/// A saved message. {first_name}, {name}, {company} and {title} fill in per person.
model Template {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  label       String
  /// amber | green | violet | blue | pink | stone
  color       String    @default("stone")
  createdAt   DateTime  @default(now())

  people PersonTag[]

  @@unique([workspaceId, label])
}

model PersonTag {
  personId String
  tagId    String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([personId, tagId])
}

model Message {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// "in" from the prospect, "out" from the user
  direction String
  body      String
  sentAt    DateTime
  /// 1 or 2 when this outbound message was a planned follow-up
  followUp  Int?
  /// "manual" (logged by hand), "helper" (Chrome helper), "api"
  source    String   @default("manual")
  /// Id on LinkedIn's side when synced, to avoid duplicates
  externalId String? @unique
  createdAt DateTime @default(now())

  @@index([personId, sentAt])
}

/// A message the user clicked Send on, waiting for the Chrome helper to deliver it.
model Outbox {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  body        String
  followUp    Int?
  /// queued | sending | sent | failed
  status      String    @default("queued")
  error       String?
  externalId  String?
  createdAt   DateTime  @default(now())
  claimedAt   DateTime?
  sentAt      DateTime?

  @@index([workspaceId, status])
}
